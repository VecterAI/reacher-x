# Isolated marketing/blog demo app; copy to demos/app/.env.local.
# This app uses fictional data and needs no Convex, WorkOS, or provider secrets.
# Required at build time and for embedded playback. Set the exact main-site
# origin (scheme + host + optional port), with no path or trailing slash.
NEXT_PUBLIC_DEMO_PARENT_ORIGIN=http://localhost:3000
# In hosting settings use the matching main-site production or preview origin.
# See ../../docs/configuration.md#interactive-demos.
